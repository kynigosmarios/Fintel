rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profile & Private Personal User Database
    match /users/{userId} {
      allow read, write: if true;

      // Personal user collections (expenses, incomes, categories, members, savings, recurring)
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Phone password reset codes (6-digit verification)
    match /phone_password_resets/{phone} {
      allow read, write: if true;
    }

    // Shared Household Database (Multi-user sync)
    match /households/{householdId} {
      allow read, write: if true;

      // Household subcollections (shared expenses, incomes, members, categories, savings, recurring, sync)
      match /{document=**} {
        allow read, write: if true;
      }
    }

    // Catch-all to prevent any unexpected permission errors
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
