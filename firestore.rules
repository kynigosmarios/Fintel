rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids
      );
    }

    // User Profile & Private Personal User Database
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.auth.uid == userId;

      // Personal user collections (expenses, categories, members, savings, recurring)
      match /{document=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Shared Household Database (Multi-user sync)
    match /households/{householdId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.memberUids ||
        request.auth.uid == resource.data.ownerId ||
        request.auth.uid in request.resource.data.memberUids
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.ownerId;

      // Household subcollections (shared expenses, members, sync)
      match /{document=**} {
        allow read, write: if isAuthenticated() && isHouseholdMember(householdId);
      }
    }
  }
}
