rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profile & Private Personal User Database
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;

      // Personal user collections (expenses, incomes, categories, members, savings, recurring)
      match /{document=**} {
        allow read, write: if isAuthenticated() && request.auth.uid == userId;
      }
    }

    // Phone password reset codes (6-digit verification)
    match /phone_password_resets/{phone} {
      allow read, write: if true;
    }

    // Shared Household Database (Multi-user sync)
    match /households/{householdId} {
      allow read, write: if isAuthenticated();

      // Household subcollections (shared expenses, incomes, members, categories, savings, recurring, sync)
      match /{document=**} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}

